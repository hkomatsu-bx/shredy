// 重複検索ページ（設計 §3.2-§3.4）。アクションバー + グループ化結果一覧。
import { Button, ScrollView, ListView, CheckBox, LineEdit, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ListRow, FolderRow, Cols, Icon, FormatField } from "types.slint";

// プレビューのメタ情報 1 行（キー左・値右, §3.5）。
component PvMetaRow inherits HorizontalLayout {
    in property <string> key;
    in property <string> value;
    spacing: 10px;
    Text {
        text: root.key;
        color: Theme.text_secondary;
        font-size: 12px;
        vertical-alignment: center;
        width: 88px;
    }
    Text {
        text: root.value;
        color: Theme.fg;
        font-size: 12px;
        vertical-alignment: center;
        horizontal-stretch: 1;
        overflow: elide;
        wrap: no-wrap;
    }
}

// コンテキストメニュー項目（フラット・左寄せ, U12 polish2）。ユーティリティページでも再利用。
export component MenuItem inherits Rectangle {
    in property <string> text;
    callback clicked();
    height: 30px;
    border-radius: Theme.radius_ctrl;
    background: ta.has-hover ? Theme.hover_bg : transparent;
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.text;
            vertical-alignment: center;
            horizontal-alignment: left;
            color: Theme.fg;
        }
    }
}

// 状態列バッジ（保持 / 削除対象 / 保護, U12 M7）。
component StateBadge inherits Rectangle {
    in property <bool> checked;
    in property <bool> locked;
    property <string> label: root.locked ? "保護" : (root.checked ? "削除対象" : "保持");
    property <brush> tint: root.locked ? Theme.warn : (root.checked ? Theme.danger : Theme.success);

    height: 18px;
    border-radius: 9px;
    background: root.tint.with-alpha(0.18);
    horizontal-stretch: 0;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: root.label;
            vertical-alignment: center;
            font-size: 11px;
            font-weight: 600;
            color: root.tint;
        }
    }
}

// 対象フォルダ一覧の 1 行（チェック・パス・削除）。ユーティリティページ（util_search）でも再利用。
export component FolderItem inherits Rectangle {
    in property <FolderRow> folder;
    in property <bool> enabled: true;
    callback toggled();
    callback removed();

    height: 28px;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        CheckBox {
            checked: root.folder.checked;
            enabled: root.enabled;
            toggled => { root.toggled(); }
            accessible-label: "検索対象に含める";
        }
        Text {
            horizontal-stretch: 1;
            text: root.folder.path;
            vertical-alignment: center;
            overflow: elide;
            color: Theme.fg;
        }
        // 削除（背景なしフラット・hover で薄色, 不具合B）。
        rm := Rectangle {
            width: 26px;
            height: 26px;
            border-radius: Theme.radius_ctrl;
            background: rm_ta.has-hover && root.enabled ? Theme.hover_bg : transparent;
            opacity: root.enabled ? 1.0 : 0.42;
            Icon {
                source: @image-url("icons/close.svg");
                tint: rm_ta.has-hover ? Theme.danger : Theme.text_secondary;
                size: 14px;
            }
            rm_ta := TouchArea {
                enabled: root.enabled;
                clicked => {
                    root.removed();
                }
            }
        }
    }
}

// 1 ファイル行。シングルクリック=ハイライト / チェック・ダブルクリック=削除選択（§3.4）。
// 右クリックで Flyout（§3.5a）。
component ResultRow inherits Rectangle {
    in property <ListRow> entry;
    in property <bool> highlighted;
    // 横スクロール量（§3.7 #3）。列の内容だけ左へずらす。背景・クリック判定は行全幅のまま。
    in property <length> h_offset: 0px;
    callback clicked();
    callback double_clicked();
    callback check_toggled();
    // Flyout 由来（§3.5a）。
    callback lock_toggle();
    callback open_explorer();
    callback select_direct(string, bool); // origin, invert
    callback select_tree(string, bool);   // origin, invert
    callback select_pattern(string);      // pattern
    // コンテキストメニュー拡充（U12 M8a/polish2）。
    callback lock_direct(string, bool);   // origin, invert
    callback lock_tree(string, bool);     // origin, invert
    callback unlock_all();
    callback clear_selection();
    callback preview_toggle();
    // 起点フォルダの親パスを算出する（↑ ボタン, §3.5a）。Rust 実装。
    pure callback parent_path(string) -> string;
    // ツールチップ（完全なファイル名・フォルダパス, polish3 指摘）。ウィンドウ座標で通知。
    callback request_tip(string, length, length);
    callback hide_tip();

    height: Theme.row_height;
    background: root.highlighted ? Theme.highlight_bg : (ta.has-hover ? Theme.hover_bg : transparent);

    // ホバー開始でツールチップ要求、離脱で消す。座標は行の絶対位置＋カーソル相対。
    property <bool> hov: ta.has-hover;
    changed hov => {
        if (root.hov) {
            root.request_tip(
                root.entry.name + "\n" + root.entry.folder,
                self.absolute-position.x + ta.mouse-x,
                self.absolute-position.y + ta.mouse-y);
        } else {
            root.hide_tip();
        }
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
        double-clicked => { root.double_clicked(); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                menu.show();
            }
        }
    }

    HorizontalLayout {
        // 内容幅に束縛し h_offset ぶん左へずらす（ヘッダと同期, §3.7 #3）。超過分は上位 ListView/コンテナの clip が処理。
        width: Cols.content_w;
        x: -root.h_offset;
        padding-left: 8px;
        padding-right: 12px;
        spacing: 8px;

        // ロック行は削除選択不可（§3.4）。チェックボックスの代わりに■塗りつぶしで保護を示す（polish3 item3）。
        if root.entry.locked: Rectangle {
            width: 20px;
            Rectangle {
                width: 14px;
                height: 14px;
                border-radius: 2px;
                border-width: 1px;
                border-color: Theme.text_tertiary;
                background: Theme.text_tertiary;
            }
        }
        if !root.entry.locked: CheckBox {
            checked: root.entry.checked;
            toggled => {
                root.check_toggled();
            }
            accessible-label: "削除選択";
        }
        // 名前列。
        Text {
            width: Cols.name;
            text: root.entry.name;
            vertical-alignment: center;
            overflow: elide;
            color: root.highlighted ? Theme.highlight_fg : (root.entry.has_error ? Theme.danger : Theme.fg);
        }
        // 場所（フォルダ）。明示幅でリサイズ可（末尾スペーサが余白を吸収）。
        Text {
            width: Cols.place;
            text: root.entry.folder;
            vertical-alignment: center;
            overflow: elide;
            color: root.highlighted ? Theme.highlight_fg : Theme.text_secondary;
        }
        // サイズ。
        Text {
            width: Cols.size;
            text: root.entry.size_text;
            horizontal-alignment: right;
            vertical-alignment: center;
            color: root.highlighted ? Theme.highlight_fg : Theme.fg;
        }
        // 更新日時。
        Text {
            width: Cols.modified;
            text: root.entry.modified;
            vertical-alignment: center;
            overflow: elide;
            color: root.highlighted ? Theme.highlight_fg : Theme.text_tertiary;
        }
        // 状態（保持 / 削除対象 / 保護）。縦中央・左寄せ。
        VerticalLayout {
            width: Cols.state;
            alignment: center;
            HorizontalLayout {
                alignment: start;
                StateBadge {
                    checked: root.entry.checked;
                    locked: root.entry.locked;
                }
            }
        }
        // 末尾の伸縮スペーサ（余白を吸収。列を独立リサイズ可能にする, polish3）。
        Rectangle {
            horizontal-stretch: 1;
        }
    }

    // コンテキストメニュー（§3.5a / polish2）。仕様順・フラット・左寄せ・白背景。
    // close-policy: 内側クリックでは閉じない（起点フォルダ TextBox を編集可能に, 不具合F）。
    menu := PopupWindow {
        x: ta.mouse-x;
        y: ta.mouse-y;
        width: 264px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: Theme.layer2;
            border-color: Theme.card_border;
            border-width: 1px;
            border-radius: Theme.radius_card;

            VerticalLayout {
                padding: 6px;
                spacing: 2px;

                // 並び順は spec §3.5a に準拠（オーナーノート順）。
                // プレビュー/エクスプローラー → 起点フォルダ → 選択群 → ロック群。
                MenuItem {
                    text: "プレビュー表示切替";
                    clicked => { root.preview_toggle(); menu.close(); }
                }
                MenuItem {
                    text: "エクスプローラー表示";
                    clicked => { root.open_explorer(); menu.close(); }
                }
                Rectangle { height: 1px; background: Theme.divider; }

                // 起点フォルダ（既定＝右クリック行の親フォルダ）。↑ で 1 階層上へ。
                HorizontalLayout {
                    spacing: 4px;
                    origin_edit := LineEdit {
                        horizontal-stretch: 1;
                        text: root.entry.folder;
                    }
                    // ↑ 親フォルダ（起点を 1 階層上げる, polish3 / 旧「F の残り #1」）。
                    // CmdButton はこの後方で定義されるため、インラインのボタンで構成する。
                    up_btn := Rectangle {
                        width: 32px;
                        border-radius: Theme.radius_ctrl;
                        border-width: 1px;
                        border-color: Theme.border_strong;
                        background: up_ta.has-hover ? Theme.hover_bg : Theme.layer2;
                        Text {
                            text: "↑";
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            color: Theme.fg;
                        }
                        up_ta := TouchArea {
                            clicked => {
                                origin_edit.text = root.parent_path(origin_edit.text);
                            }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.divider; }

                // 選択群（単一「このファイルを選択」を先頭に, §3.5a）。
                MenuItem {
                    text: "このファイルを選択";
                    clicked => { root.check_toggled(); menu.close(); }
                }
                MenuItem {
                    text: "フォルダ直下を選択";
                    clicked => { root.select_direct(origin_edit.text, false); menu.close(); }
                }
                MenuItem {
                    text: "フォルダ直下以外を選択";
                    clicked => { root.select_direct(origin_edit.text, true); menu.close(); }
                }
                MenuItem {
                    text: "ツリー直下を選択";
                    clicked => { root.select_tree(origin_edit.text, false); menu.close(); }
                }
                MenuItem {
                    text: "ツリー直下以外を選択";
                    clicked => { root.select_tree(origin_edit.text, true); menu.close(); }
                }
                MenuItem {
                    text: "全選択解除";
                    clicked => { root.clear_selection(); menu.close(); }
                }
                Rectangle { height: 1px; background: Theme.divider; }

                // ロック群（単一「このファイルをロック」を先頭に, §3.5a）。
                MenuItem {
                    text: "このファイルをロック";
                    clicked => { root.lock_toggle(); menu.close(); }
                }
                MenuItem {
                    text: "フォルダ直下をロック";
                    clicked => { root.lock_direct(origin_edit.text, false); menu.close(); }
                }
                MenuItem {
                    text: "フォルダ直下以外をロック";
                    clicked => { root.lock_direct(origin_edit.text, true); menu.close(); }
                }
                MenuItem {
                    text: "ツリー直下をロック";
                    clicked => { root.lock_tree(origin_edit.text, false); menu.close(); }
                }
                MenuItem {
                    text: "ツリー直下以外をロック";
                    clicked => { root.lock_tree(origin_edit.text, true); menu.close(); }
                }
                MenuItem {
                    text: "全ロック解除";
                    clicked => { root.unlock_all(); menu.close(); }
                }
            }
        }
    }
}

// コマンドバー用ボタン（accent/danger/toggle の配色制御。std Button では色を変えにくい）。
// ユーティリティページ（util_search）でも再利用するため export。
export component CmdButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    in property <bool> danger_solid: false;
    in property <bool> danger_text: false; // 赤字・透過背景・hover で薄赤（選択削除, 不具合C）
    in property <bool> outlined: false; // 白背景＋境界線（フォルダ追加, polish3 item8）
    in property <bool> toggled: false;
    in property <int> badge: 0;
    in property <bool> show_chevron: false;
    callback clicked();

    height: 32px;
    min-width: 32px;
    border-radius: Theme.radius_ctrl;
    border-width: root.outlined ? 1px : 0px;
    border-color: Theme.border_strong;
    opacity: root.enabled ? 1.0 : 0.42;
    background: root.primary ? Theme.accent
        : root.danger_solid ? Theme.danger
        : root.danger_text ? (ta.has-hover && root.enabled ? Theme.danger.with-alpha(0.14) : transparent)
        : root.outlined ? (ta.has-hover && root.enabled ? Theme.hover_bg : Theme.layer2)
        : root.toggled ? Theme.row_sel
        : (ta.has-hover && root.enabled ? Theme.hover_bg : transparent);

    accessible-role: button;
    accessible-label: root.text;

    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 7px;
        alignment: start;
        if root.icon.width > 0: Icon {
            source: root.icon;
            tint: root.primary ? Theme.accent_fg : (root.danger_solid ? #ffffff : (root.danger_text ? Theme.danger : Theme.fg));
            size: 15px;
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            color: root.primary ? Theme.accent_fg : (root.danger_solid ? #ffffff : (root.danger_text ? Theme.danger : Theme.fg));
        }
        if root.badge > 0: Rectangle {
            height: 17px;
            min-width: 17px;
            border-radius: 8px;
            background: root.danger_text ? Theme.danger.with-alpha(0.18) : rgba(255, 255, 255, 0.28);
            HorizontalLayout {
                padding-left: 5px;
                padding-right: 5px;
                Text {
                    text: root.badge;
                    vertical-alignment: center;
                    font-size: 11px;
                    color: root.danger_text ? Theme.danger : #ffffff;
                }
            }
        }
        if root.show_chevron: Icon {
            source: @image-url("icons/chevron-down.svg");
            tint: root.primary ? Theme.accent_fg : Theme.text_secondary;
            size: 12px;
        }
    }
}

export component DupSearchPage inherits VerticalLayout {
    in property <[ListRow]> rows;
    in property <[FolderRow]> target_folders;
    in property <int> checked_count: 0;
    in property <bool> is_searching: false;
    in property <string> status_text: "";
    // サマリ（U12 M6）。
    in property <int> summary_groups: 0;
    in property <int> summary_files: 0;
    in property <string> summary_potential: "0 B";
    in property <bool> recycle_on: true;
    in property <string> compare_method_label: "ハッシュ (BLAKE3)";
    in property <int> compare_method_index: 0;
    in property <string> keep_rule_label: "更新日（最新）を保持";
    in property <int> filter_mode: 0; // 0=なし / 1=選択済みのみ / 2=未選択のみ
    // プレビューパネル（§3.5 / U12 polish）。
    in-out property <bool> preview_open: false;
    in property <int> preview_kind: 2;
    in property <image> preview_image;
    in property <string> preview_text: "";
    in property <string> preview_name: "";
    in-out property <int> preview_rotation: 0;
    // プレビューのメタ情報（§3.5）。種別（拡張子）のみ表示する（サイズ等は一覧で確認可）。
    in property <string> preview_ext: "";
    // 画像 EXIF 情報（§3.1#1）。画像プレビュー時のみ・各値が空でない項目だけ行表示する。
    in property <string> preview_exif_datetime: "";
    in property <string> preview_exif_camera: "";
    in property <string> preview_exif_lens: "";
    in property <string> preview_exif_gps: "";
    in property <[FormatField]> preview_format_meta;
    in-out property <int> highlighted_group: -1;
    in-out property <int> highlighted_file: -1;

    callback scan_clicked();
    callback cancel_clicked();
    callback clear_selection();
    callback select_all();
    callback request_delete();
    callback toggle_check(int, int);
    callback row_clicked(int, int);
    callback row_double_clicked(int, int);
    callback open_in_explorer(int, int);
    // コンテキストメニュー（§3.5a）。
    callback toggle_lock(int, int);
    callback select_direct_cb(string, bool);
    callback select_tree_cb(string, bool);
    callback select_pattern_cb(string);
    // 対象フォルダ管理（§5 TargetFolders）。
    callback add_folder();
    callback remove_folder(int);
    callback toggle_folder(int);
    callback check_all_folders();
    callback uncheck_all_folders();
    callback remove_all_folders();
    // アクションバー（U12 M6）。
    callback set_compare_method(int);
    callback set_filter(int);
    // その他サブメニュー・一括ロック・コンテキスト拡充（U12 M8a）。
    callback lock_all();
    callback unlock_all();
    callback lock_direct_cb(string, bool);
    callback lock_tree_cb(string, bool);
    callback preview_toggle();
    callback notify_unimplemented(string);
    callback open_pattern_dialog();
    callback request_move();
    callback request_manual();
    callback recheck();
    callback save_result();
    callback review();
    callback preview_rotate();
    callback preview_open_with();
    callback preview_show_folder();

    // 選択中フォルダ件数（"N / M 選択" 表示用。Rust 供給）。
    in property <int> folders_checked: 0;
    // 起点フォルダの親パス算出（↑ ボタン, §3.5a）。AppWindow→Rust へ中継。
    pure callback parent_path(string) -> string;
    // ツールチップ（行ホバーで完全なファイル名・フォルダパス, polish3 指摘）。AppWindow へ中継。
    callback request_tip(string, length, length);
    callback hide_tip();

    // 横スクロール状態（§3.7 #3）。list_pane_w=結果一覧コンテナの実幅、
    // h_offset=横スクロール量。列幅合計 Cols.content_w がペイン幅を超えたぶんだけ動く。
    property <length> list_pane_w: list_pane.width;
    property <length> max_h_offset: max(0px, Cols.content_w - root.list_pane_w);
    property <length> h_offset: 0px;
    // 実効オフセット = h_offset を [0, max] にクランプ（changed ハンドラを使わず派生プロパティで
    // 上限詰め＝列縮小/ウィンドウ拡大で内容幅が減っても破綻しない）。描画は全て eff_offset を使う。
    property <length> eff_offset: min(max(0px, root.h_offset), root.max_h_offset);

    spacing: 8px;
    padding: Theme.pane_padding;

    // ページ見出し（コンテンツ領域上部に機能名を表記, polish3 指摘）。
    Text {
        text: "重複ファイル検索";
        color: Theme.fg;
        font-size: 18px;
        font-weight: 700;
    }

    // 対象フォルダ管理パネル（§5）。
    Rectangle {
        border-radius: 6px;
        background: Theme.group_header_bg;
        VerticalLayout {
            padding: 6px;
            spacing: 4px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "対象フォルダ";
                    vertical-alignment: center;
                    font-weight: 700;
                    color: Theme.fg;
                }
                Text {
                    text: root.folders_checked + " / " + root.target_folders.length + " 選択";
                    vertical-alignment: center;
                    color: Theme.text_secondary;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                CmdButton {
                    text: "全て選択";
                    enabled: !root.is_searching && root.target_folders.length > 0;
                    clicked => {
                        root.check_all_folders();
                    }
                }
                CmdButton {
                    text: "全て解除";
                    enabled: !root.is_searching && root.target_folders.length > 0;
                    clicked => {
                        root.uncheck_all_folders();
                    }
                }
                CmdButton {
                    text: "全て削除";
                    danger_text: true;
                    enabled: !root.is_searching && root.target_folders.length > 0;
                    clicked => {
                        root.remove_all_folders();
                    }
                }
                // フォルダ追加は白背景＋境界線（polish3 item8）。
                CmdButton {
                    text: "＋ フォルダ追加";
                    outlined: true;
                    enabled: !root.is_searching;
                    clicked => {
                        root.add_folder();
                    }
                }
            }
            // フォルダパスを常時 3 行程度はスクロールなしで表示（min で確保・max で上限, polish3 指摘）。
            ScrollView {
                min-height: 88px;
                max-height: 120px;
                vertical-stretch: 0;
                VerticalLayout {
                    alignment: start;
                    if root.target_folders.length == 0: Text {
                        text: "（未設定）「フォルダ追加」で対象を追加してください";
                        color: Theme.fg;
                        height: 28px;
                        vertical-alignment: center;
                    }
                    for folder[i] in root.target_folders: FolderItem {
                        folder: folder;
                        enabled: !root.is_searching;
                        toggled => { root.toggle_folder(i); }
                        removed => { root.remove_folder(i); }
                    }
                }
            }
        }
    }

    // アクションバー（コマンドバー様式, §3.5a / U12 M6）。検索中は中断以外を無効化（§5.5）。
    Rectangle {
        border-radius: Theme.radius_card;
        background: Theme.layer;
        border-width: 1px;
        border-color: Theme.card_border;
        vertical-stretch: 0;
        height: 46px;

        HorizontalLayout {
            padding: 6px;
            spacing: 4px;
            alignment: start;

            // 比較方式プルダウン（選択は次回スキャンへ保留）。固定幅でラベル変化による位置ずれを防ぐ。
            cmp_btn := CmdButton {
                width: 136px; // 比較方式（検索方法）プルダウン。フィルタと幅を揃える（polish3）
                text: root.compare_method_label;
                show_chevron: true;
                enabled: !root.is_searching;
                clicked => {
                    cmp_menu.show();
                }
            }
            Rectangle {
                width: 1px;
                background: Theme.divider;
            }
            CmdButton {
                width: 112px; // 「スキャン開始」⇔「中断」のキャプション変化で幅を固定（polish3 で短縮）
                text: root.is_searching ? "中断" : "スキャン開始";
                icon: root.is_searching ? @image-url("icons/stop.svg") : @image-url("icons/play.svg");
                primary: !root.is_searching;
                clicked => {
                    if (root.is_searching) {
                        root.cancel_clicked();
                    } else {
                        root.scan_clicked();
                    }
                }
            }
            CmdButton {
                text: "全選択";
                icon: @image-url("icons/check-all.svg");
                enabled: !root.is_searching && root.summary_groups > 0;
                clicked => {
                    root.select_all();
                }
            }
            CmdButton {
                text: "全選択解除";
                icon: @image-url("icons/deselect.svg");
                enabled: !root.is_searching && root.checked_count > 0;
                clicked => {
                    root.clear_selection();
                }
            }
            CmdButton {
                text: "選択削除";
                icon: @image-url("icons/trash.svg");
                danger_text: true;
                badge: root.checked_count;
                enabled: !root.is_searching && root.checked_count > 0;
                clicked => {
                    root.request_delete();
                }
            }
            // 表示フィルタ（ドロップダウン: 選択済みのみ/未選択のみ, polish3 指摘）。
            // ラベル変化で右隣「その他」が動かないよう幅を固定（polish3 指摘）。
            filter_btn := CmdButton {
                width: 136px;
                text: root.filter_mode == 1 ? "選択済みのみ" : root.filter_mode == 2 ? "未選択のみ" : "絞り込み";
                icon: @image-url("icons/filter.svg");
                show_chevron: true;
                toggled: root.filter_mode != 0;
                enabled: !root.is_searching;
                clicked => {
                    filter_menu.show();
                }
            }
            Rectangle {
                horizontal-stretch: 1;
            }
            more_btn := CmdButton {
                text: "その他";
                show_chevron: true;
                enabled: !root.is_searching;
                clicked => {
                    more_menu.show();
                }
            }
        }

        // その他サブメニュー（§3.5a / U12 M8a）。移動/手動削除は M8b で配線。
        // 位置は その他 ボタンの右端へ右寄せ（最大化でもボタン直下に追従, polish3 指摘）。
        more_menu := PopupWindow {
            x: more_btn.x + more_btn.width - self.width;
            y: 44px;
            width: 252px;
            Rectangle {
                background: Theme.layer2;
                border-color: Theme.card_border;
                border-width: 1px;
                border-radius: Theme.radius_card;
                VerticalLayout {
                    padding: 5px;
                    spacing: 2px;
                    CmdButton {
                        text: "全選択（1つ残す）";
                        enabled: root.summary_groups > 0;
                        clicked => {
                            root.select_all();
                            more_menu.close();
                        }
                    }
                    CmdButton {
                        text: "全選択解除";
                        clicked => {
                            root.clear_selection();
                            more_menu.close();
                        }
                    }
                    CmdButton {
                        text: "全ロック（1つ残す）";
                        enabled: root.summary_groups > 0;
                        clicked => {
                            root.lock_all();
                            more_menu.close();
                        }
                    }
                    CmdButton {
                        text: "全ロック解除";
                        clicked => {
                            root.unlock_all();
                            more_menu.close();
                        }
                    }
                    CmdButton {
                        text: "ワイルドカード選択/ロック…";
                        clicked => {
                            root.open_pattern_dialog();
                            more_menu.close();
                        }
                    }
                    Rectangle {
                        height: 1px;
                        background: Theme.divider;
                    }
                    CmdButton {
                        text: "選択ファイルを移動…";
                        enabled: root.checked_count > 0;
                        clicked => {
                            root.request_move();
                            more_menu.close();
                        }
                    }
                    CmdButton {
                        text: "手動削除…";
                        enabled: root.checked_count > 0;
                        clicked => {
                            root.request_manual();
                            more_menu.close();
                        }
                    }
                    Rectangle {
                        height: 1px;
                        background: Theme.divider;
                    }
                    CmdButton {
                        text: "結果保存…";
                        enabled: root.summary_groups > 0;
                        clicked => {
                            root.save_result();
                            more_menu.close();
                        }
                    }
                    CmdButton {
                        text: "見直す（保存結果を読み込み）";
                        clicked => {
                            root.review();
                            more_menu.close();
                        }
                    }
                    CmdButton {
                        text: "再チェック（存在確認）";
                        enabled: root.summary_groups > 0;
                        clicked => {
                            root.recheck();
                            more_menu.close();
                        }
                    }
                    CmdButton {
                        text: "フォルダ比較…";
                        clicked => {
                            root.notify_unimplemented("フォルダ比較");
                            more_menu.close();
                        }
                    }
                }
            }
        }

        // 表示フィルタメニュー（選択済みのみ/未選択のみ。同一項目の再選択で解除, polish3 指摘）。
        filter_menu := PopupWindow {
            x: filter_btn.x;
            y: 44px;
            width: 180px;
            Rectangle {
                background: Theme.layer2;
                border-color: Theme.card_border;
                border-width: 1px;
                border-radius: Theme.radius_card;
                VerticalLayout {
                    padding: 5px;
                    spacing: 2px;
                    CmdButton {
                        text: "選択済みのみ";
                        toggled: root.filter_mode == 1;
                        clicked => {
                            root.set_filter(1);
                            filter_menu.close();
                        }
                    }
                    CmdButton {
                        text: "未選択のみ";
                        toggled: root.filter_mode == 2;
                        clicked => {
                            root.set_filter(2);
                            filter_menu.close();
                        }
                    }
                }
            }
        }

        // 比較方式メニュー（9 方式・index 順は Rust 側 view::compare_method_from_index と一対一）。
        // CompareMethod に variant を追加したら、ここの項目と Rust の index 変換も更新すること。
        cmp_menu := PopupWindow {
            x: 6px;
            y: 44px;
            width: 220px;
            Rectangle {
                background: Theme.layer2;
                border-color: Theme.card_border;
                border-width: 1px;
                border-radius: Theme.radius_card;
                VerticalLayout {
                    padding: 5px;
                    spacing: 2px;
                    CmdButton {
                        text: "ハッシュ (BLAKE3)";
                        toggled: root.compare_method_index == 0;
                        clicked => {
                            root.set_compare_method(0);
                            cmp_menu.close();
                        }
                    }
                    CmdButton {
                        text: "ハッシュ (SHA-256)";
                        toggled: root.compare_method_index == 1;
                        clicked => {
                            root.set_compare_method(1);
                            cmp_menu.close();
                        }
                    }
                    CmdButton {
                        text: "ハッシュ (XXH3-128)";
                        toggled: root.compare_method_index == 2;
                        clicked => {
                            root.set_compare_method(2);
                            cmp_menu.close();
                        }
                    }
                    CmdButton {
                        text: "部分一致";
                        toggled: root.compare_method_index == 3;
                        clicked => {
                            root.set_compare_method(3);
                            cmp_menu.close();
                        }
                    }
                    CmdButton {
                        text: "名前+サイズ+日付";
                        toggled: root.compare_method_index == 4;
                        clicked => {
                            root.set_compare_method(4);
                            cmp_menu.close();
                        }
                    }
                    CmdButton {
                        text: "名前+サイズ";
                        toggled: root.compare_method_index == 5;
                        clicked => {
                            root.set_compare_method(5);
                            cmp_menu.close();
                        }
                    }
                    CmdButton {
                        text: "名前のみ";
                        toggled: root.compare_method_index == 6;
                        clicked => {
                            root.set_compare_method(6);
                            cmp_menu.close();
                        }
                    }
                    CmdButton {
                        text: "Office 類似度";
                        toggled: root.compare_method_index == 7;
                        clicked => {
                            root.set_compare_method(7);
                            cmp_menu.close();
                        }
                    }
                    CmdButton {
                        text: "画像類似度";
                        toggled: root.compare_method_index == 8;
                        clicked => {
                            root.set_compare_method(8);
                            cmp_menu.close();
                        }
                    }
                }
            }
        }
    }

    // 結果サマリバー（U12 M6 / polish2）。上段＝状態＋チップ、下段＝件数（数値は紫の太字）。
    Rectangle {
        border-radius: Theme.radius_card;
        background: Theme.layer;
        border-width: 1px;
        border-color: Theme.card_border;
        vertical-stretch: 0;

        VerticalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 9px;
            padding-bottom: 9px;
            spacing: 5px;

            // 上段: 状態ドット＋状態テキスト（＋右にチップ）。
            HorizontalLayout {
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 9px;
                        height: 9px;
                        border-radius: 5px;
                        background: root.is_searching ? Theme.accent : (root.summary_groups > 0 ? Theme.success : Theme.text_tertiary);
                    }
                }
                Text {
                    text: root.status_text != "" ? root.status_text : "待機中";
                    vertical-alignment: center;
                    font-weight: 600;
                    color: Theme.fg;
                    overflow: elide;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                // チップ（ごみ箱 / 比較方式 / 保持ルール）。
                if !root.is_searching: HorizontalLayout {
                    spacing: 12px;
                    Text {
                        text: "ごみ箱: " + (root.recycle_on ? "ON" : "OFF");
                        vertical-alignment: center;
                        font-size: 12px;
                        color: root.recycle_on ? Theme.success : Theme.text_secondary;
                    }
                    Text {
                        text: root.compare_method_label;
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Theme.text_secondary;
                    }
                    Text {
                        text: root.keep_rule_label;
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Theme.text_secondary;
                    }
                }
            }

            // 下段: 件数（グループ / ファイル / 削除可能）。数値は紫・太字・やや大きめ。
            // 数値とラベルはベースライン感を揃えるため、いずれも下端揃え（polish3 item2）。
            HorizontalLayout {
                spacing: 4px;
                alignment: start;
                Text {
                    text: root.summary_groups;
                    vertical-alignment: bottom;
                    font-size: 18px;
                    font-weight: 700;
                    color: Theme.summary_number;
                }
                Text {
                    text: " グループ ·";
                    vertical-alignment: bottom;
                    font-size: 13px;
                    color: Theme.text_secondary;
                }
                Text {
                    text: root.summary_files;
                    vertical-alignment: bottom;
                    font-size: 18px;
                    font-weight: 700;
                    color: Theme.summary_number;
                }
                Text {
                    text: " ファイル · 最大";
                    vertical-alignment: bottom;
                    font-size: 13px;
                    color: Theme.text_secondary;
                }
                Text {
                    text: root.summary_potential;
                    vertical-alignment: bottom;
                    font-size: 18px;
                    font-weight: 700;
                    color: Theme.summary_number;
                }
                Text {
                    text: "削除可能";
                    vertical-alignment: bottom;
                    font-size: 13px;
                    color: Theme.text_secondary;
                }
            }
        }
    }

    // 結果一覧 + プレビューパネル（§3.3 / §3.5）。
    HorizontalLayout {
        vertical-stretch: 1;
        spacing: 8px;
        list_pane := Rectangle {
        horizontal-stretch: 1;
        // 列を広げても合計幅が他パネルを押し広げないようクリップ＋最小幅を 0 にして伝播を遮断（polish3）。
        // 実幅は list_pane.width として root.list_pane_w が遅延参照し、横スクロール量の上限算出に使う（§3.7 #3）。
        clip: true;
        min-width: 0px;
        VerticalLayout {
            // 列ヘッダ（各行と同じ Cols 幅で整列, U12 M7）。各列はヘッダ右端ドラッグでリサイズ。
            Rectangle {
                height: 30px;
                background: Theme.group_header_bg;
                clip: true;
                min-width: 0px;
                HorizontalLayout {
                    // 内容幅に束縛し、h_offset ぶん左へずらして横スクロールを表現（§3.7 #3）。
                    // 超過分は親 Rectangle の clip が処理する。
                    width: Cols.content_w;
                    x: -root.eff_offset;
                    padding-left: 8px;
                    padding-right: 12px;
                    spacing: 8px;
                    Rectangle {
                        width: 20px;
                    }
                    Text {
                        width: Cols.name;
                        text: "ファイル名";
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Theme.text_secondary;
                    }
                    Text {
                        width: Cols.place;
                        text: "場所";
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Theme.text_secondary;
                    }
                    Text {
                        width: Cols.size;
                        text: "サイズ";
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Theme.text_secondary;
                    }
                    Text {
                        width: Cols.modified;
                        text: "更新日時";
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Theme.text_secondary;
                    }
                    Text {
                        width: Cols.state;
                        text: "状態";
                        vertical-alignment: center;
                        font-size: 12px;
                        color: Theme.text_secondary;
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                }
                // 列リサイズ（安定方式: ヘッダ全幅の固定 TouchArea。pointer x から幅を決定）。
                // 全列が明示幅を持ち末尾スペーサが余白を吸収するため、各列の右端を掴んで
                // その列だけを独立にリサイズできる（場所列を巻き込まない, polish3）。
                // 各列の右端 = 左端オフセット + 累積幅（左から積み上げ）。
                //   名前左端 = padding-left 8 + チェック枠 20 + spacing 8 = 36px。
                resize_ta := TouchArea {
                    // ヘッダ内容（HorizontalLayout）と完全に重ねる。横スクロールに追従するよう
                    // 同じ内容幅・同じ x オフセットを持たせ、mouse-x を内容座標と一致させる（§3.7 #3）。
                    width: Cols.content_w;
                    x: -root.eff_offset;
                    height: parent.height;
                    property <length> name_edge: 36px + Cols.name;
                    property <length> place_edge: self.name_edge + 8px + Cols.place;
                    property <length> size_edge: self.place_edge + 8px + Cols.size;
                    property <length> modified_edge: self.size_edge + 8px + Cols.modified;
                    // -1=なし / 0=name / 1=place / 2=size / 3=modified。
                    property <int> drag_col: -1;
                    mouse-cursor: (abs(self.mouse-x - self.name_edge) < 8px
                        || abs(self.mouse-x - self.place_edge) < 8px
                        || abs(self.mouse-x - self.size_edge) < 8px
                        || abs(self.mouse-x - self.modified_edge) < 8px)
                        ? MouseCursor.col-resize : MouseCursor.default;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            if (abs(self.mouse-x - self.name_edge) < 8px) {
                                self.drag_col = 0;
                            } else if (abs(self.mouse-x - self.place_edge) < 8px) {
                                self.drag_col = 1;
                            } else if (abs(self.mouse-x - self.size_edge) < 8px) {
                                self.drag_col = 2;
                            } else if (abs(self.mouse-x - self.modified_edge) < 8px) {
                                self.drag_col = 3;
                            } else {
                                self.drag_col = -1;
                            }
                        }
                        if (e.kind == PointerEventKind.up) {
                            self.drag_col = -1;
                        }
                    }
                    moved => {
                        // 各列は右端ドラッグで自列のみリサイズ（右の列は平行移動・末尾スペーサ吸収）。
                        // 上限クランプは撤去し、ペイン幅を超えた拡張を許可（横スクロールで到達, §3.7 #3）。
                        // 1 ドラッグの到達範囲は可視ペイン右端（mouse-x の上限）に自然に制限される。
                        if (self.drag_col == 0) {
                            Cols.name = max(Cols.min, self.mouse-x - 36px);
                        } else if (self.drag_col == 1) {
                            Cols.place = max(Cols.min, self.mouse-x - self.name_edge - 8px);
                        } else if (self.drag_col == 2) {
                            Cols.size = max(Cols.min, self.mouse-x - self.place_edge - 8px);
                        } else if (self.drag_col == 3) {
                            Cols.modified = max(Cols.min, self.mouse-x - self.size_edge - 8px);
                        }
                    }
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.divider;
            }
            // 仮想化リスト（ListView は可視デリゲートのみ実体化＝リサイズ/スクロールが軽い, U12 perf）。
            // ヘッダ行とファイル行を平坦化した単一モデル（root.rows）を流す。
            ListView {
                for r in root.rows: Rectangle {
                    height: r.is_header ? 28px : Theme.row_height;
                    // グループ見出し行。
                    if r.is_header: Rectangle {
                        background: Theme.group_header_bg;
                        HorizontalLayout {
                            padding-left: 8px;
                            Text {
                                text: r.header;
                                vertical-alignment: center;
                                font-weight: 700;
                                font-size: 12px;
                                color: Theme.fg;
                            }
                        }
                    }
                    // ファイル行（gi/fi は元グループ座標。フィルタで絞っても座標不変）。
                    if !r.is_header: ResultRow {
                        entry: r;
                        h_offset: root.eff_offset;
                        highlighted: r.gi == root.highlighted_group && r.fi == root.highlighted_file;
                        // §3.4 改: ハイライト/トグルは Rust（SelectionState）が決め refresh で反映。
                        clicked => {
                            root.row_clicked(r.gi, r.fi);
                        }
                        double_clicked => {
                            root.row_double_clicked(r.gi, r.fi);
                        }
                        check_toggled => {
                            root.toggle_check(r.gi, r.fi);
                        }
                        lock_toggle => {
                            root.toggle_lock(r.gi, r.fi);
                        }
                        open_explorer => {
                            root.open_in_explorer(r.gi, r.fi);
                        }
                        select_direct(o, inv) => {
                            root.select_direct_cb(o, inv);
                        }
                        select_tree(o, inv) => {
                            root.select_tree_cb(o, inv);
                        }
                        select_pattern(p) => {
                            root.select_pattern_cb(p);
                        }
                        lock_direct(o, inv) => {
                            root.lock_direct_cb(o, inv);
                        }
                        lock_tree(o, inv) => {
                            root.lock_tree_cb(o, inv);
                        }
                        unlock_all => {
                            root.unlock_all();
                        }
                        clear_selection => {
                            root.clear_selection();
                        }
                        preview_toggle => {
                            root.preview_toggle();
                        }
                        parent_path(p) => {
                            root.parent_path(p)
                        }
                        request_tip(t, x, y) => {
                            root.request_tip(t, x, y);
                        }
                        hide_tip => {
                            root.hide_tip();
                        }
                    }
                }
            }
            // 横スクロールバー（§3.7 #3）。内容幅がペイン幅を超えるときだけ出す。レイアウトの
            // 最後の子（高さ 12px の Rectangle）として置く。VerticalLayout 等のレイアウト要素にすると
            // 「materialize→自前レイアウト→親レイアウト読み」の循環になるため Rectangle に留め、
            // かつ幾何（self.width/parent.*）を一切読まず確定値 root.list_pane_w から算出する
            // （std-widgets ScrollBar は公開 API 不安定のため自前）。
            Rectangle {
                // 常設要素。横スクロール不要時は高さ 0＋不可視で畳む。height は縦の layoutinfo にしか
                // 効かず、max_h_offset は list_pane の「幅」由来なので幅↔高さで循環しない（条件 if で
                // 要素自体を出し入れすると横の layoutinfo が max_h_offset に依存して循環するため避ける）。
                height: root.max_h_offset > 0px ? 12px : 0px;
                visible: root.max_h_offset > 0px;
                background: Theme.group_header_bg;
                track_ta := TouchArea {
                    // サム幅 = 可視割合、移動可能距離 = ペイン幅 - サム幅、サム位置 = h_offset に比例。
                    // すべて確定値 root.list_pane_w 由来（レイアウト幾何を読まないことで循環を避ける）。
                    property <length> thumb_w: max(40px, root.list_pane_w * (root.list_pane_w / Cols.content_w));
                    property <length> travel: max(0px, root.list_pane_w - self.thumb_w);
                    property <length> thumb_x: root.max_h_offset > 0px ? self.travel * (root.eff_offset / root.max_h_offset) : 0px;
                    // 掴んだ点とサム左端のオフセット（ドラッグ中に掴み位置を維持）。
                    property <length> grab_dx: 0px;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            if (self.mouse-x >= self.thumb_x && self.mouse-x <= self.thumb_x + self.thumb_w) {
                                // サム上を掴んだ: そのままドラッグ。
                                self.grab_dx = self.mouse-x - self.thumb_x;
                            } else {
                                // トラックの空白をクリック: サム中心をカーソルへ寄せて即ジャンプ。
                                self.grab_dx = self.thumb_w / 2;
                                root.h_offset = self.travel > 0px
                                    ? root.max_h_offset * (max(0px, min(self.travel, self.mouse-x - self.grab_dx)) / self.travel)
                                    : 0px;
                            }
                        }
                    }
                    moved => {
                        root.h_offset = self.travel > 0px
                            ? root.max_h_offset * (max(0px, min(self.travel, self.mouse-x - self.grab_dx)) / self.travel)
                            : 0px;
                    }
                    Rectangle {
                        x: parent.thumb_x;
                        y: 2px;
                        width: parent.thumb_w;
                        height: 8px;
                        border-radius: 4px;
                        background: track_ta.has-hover || track_ta.pressed ? Theme.text_secondary : Theme.text_tertiary;
                    }
                }
            }
        }

        // 検索中は結果領域に Wait カーソルを表示し、行操作を抑止する（§5.5）。
        // 中断ボタンはアクションバー（この領域の外）にあり通常カーソルのまま。
        if root.is_searching: TouchArea {
            mouse-cursor: wait;
        }
        }

        // プレビューパネル（§3.5）。画像/テキスト/非対応(関連付け)で出し分け。
        if root.preview_open: Rectangle {
            width: 360px;
            border-radius: Theme.radius_card;
            background: Theme.layer;
            border-width: 1px;
            border-color: Theme.card_border;
            VerticalLayout {
                padding: 12px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 4px;
                    Text {
                        horizontal-stretch: 1;
                        text: root.preview_name;
                        vertical-alignment: center;
                        font-weight: 700;
                        overflow: elide;
                        color: Theme.fg;
                    }
                    // 回転（画像のみ・閉じるの左隣, §3.5 指摘）。フラット・SVG アイコン。
                    if root.preview_kind == 0: Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: Theme.radius_ctrl;
                        background: rotate_ta.has-hover ? Theme.hover_bg : transparent;
                        Icon {
                            source: @image-url("icons/rotate.svg");
                            tint: rotate_ta.has-hover ? Theme.fg : Theme.text_secondary;
                            size: 14px;
                        }
                        rotate_ta := TouchArea {
                            clicked => {
                                root.preview_rotate();
                            }
                        }
                    }
                    // 閉じる（フラット・SVG アイコン。font グリフの豆腐化を回避, §3.5 指摘）。
                    close_btn := Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: Theme.radius_ctrl;
                        background: close_ta.has-hover ? Theme.hover_bg : transparent;
                        Icon {
                            source: @image-url("icons/close.svg");
                            tint: close_ta.has-hover ? Theme.danger : Theme.text_secondary;
                            size: 14px;
                        }
                        close_ta := TouchArea {
                            clicked => {
                                root.preview_toggle();
                            }
                        }
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Theme.divider;
                }
                // 画像プレビュー（回転は上部ヘッダのボタンで操作）。
                if root.preview_kind == 0: Image {
                    vertical-stretch: 1;
                    source: root.preview_image;
                    image-fit: contain;
                    transform-rotation: root.preview_rotation * 1deg;
                }
                // テキストプレビュー（先頭 8192 文字・読み取り専用）。
                if root.preview_kind == 1: TextEdit {
                    vertical-stretch: 1;
                    read-only: true;
                    text: root.preview_text;
                }
                // 非対応形式: メタ情報＋アプリで開く / フォルダを表示（§3.5 要件変更）。
                if root.preview_kind == 2: VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 10px;
                    Text {
                        text: "このファイル形式は内容プレビューに非対応です。ファイル情報を表示します。";
                        wrap: word-wrap;
                        color: Theme.text_secondary;
                        font-size: 12px;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Button {
                            text: "アプリで開く";
                            clicked => {
                                root.preview_open_with();
                            }
                        }
                        Button {
                            text: "フォルダを表示";
                            clicked => {
                                root.preview_show_folder();
                            }
                        }
                    }
                    Rectangle {
                        vertical-stretch: 1;
                    }
                }
                // メタ情報（種別のみ。サイズ・更新日時・場所は一覧で確認可のため非表示, §3.5 指摘）。
                Rectangle {
                    height: 1px;
                    background: Theme.divider;
                }
                PvMetaRow {
                    key: "種類";
                    value: root.preview_ext;
                }
                // 画像 EXIF（§3.1#1）。画像プレビュー時のみ・値がある項目だけ表示する。
                if root.preview_kind == 0 && root.preview_exif_datetime != "": PvMetaRow {
                    key: "撮影日時";
                    value: root.preview_exif_datetime;
                }
                if root.preview_kind == 0 && root.preview_exif_camera != "": PvMetaRow {
                    key: "カメラ";
                    value: root.preview_exif_camera;
                }
                if root.preview_kind == 0 && root.preview_exif_lens != "": PvMetaRow {
                    key: "レンズ";
                    value: root.preview_exif_lens;
                }
                if root.preview_kind == 0 && root.preview_exif_gps != "": PvMetaRow {
                    key: "撮影位置";
                    value: root.preview_exif_gps;
                }
                // 形式固有メタデータ（§3.1#2）。Office/ZIP など対応形式のみ Rust 側が行を供給する
                // （非対応形式はモデルが空のため何も表示されない。空値フィールドは core 側で
                // 除外済みのため、EXIF 行のような空文字判定は不要）。
                for f in root.preview_format_meta: PvMetaRow {
                    key: f.key;
                    value: f.value;
                }
            }
        }
    }
}
